  "dependencies": {
    "@scmh/database": "workspace:*",
    "@scmh/shared": "workspace:*",
    "drizzle-orm": "^0.44.5",
    "hono": "^4.9.6"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250906.0",
    "typescript": "^5.9.2",
    "wrangler": "^4.33.1"
  }
}